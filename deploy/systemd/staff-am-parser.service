[Unit]
Description=Staff.am job parser
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/Staff_am_Parser
EnvironmentFile=%h/Documents/Staff_am_Parser/.env
ExecStartPre=%h/Documents/Staff_am_Parser/.venv/bin/python healthcheck.py
ExecStart=%h/Documents/Staff_am_Parser/.venv/bin/python parser.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/Documents/Staff_am_Parser
